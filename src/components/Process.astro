<section id="process" class="py-24 bg-white dark:bg-slate-950 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Animated Image Section -->
      <div
        class="order-2 lg:order-1 relative group perspective-1000"
        id="process-image-container"
      >
        <div
          class="absolute -inset-4 bg-gradient-to-r from-blue-600 to-cyan-500 rounded-2xl opacity-20 blur-xl group-hover:opacity-30 transition duration-1000"
        >
        </div>
        <img
          src="https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
          alt="Team collaboration"
          id="process-img"
          class="relative rounded-2xl shadow-2xl grayscale hover:grayscale-0 transition duration-500 border border-white/50 z-10"
          onerror="this.src='https://placehold.co/600x400/e2e8f0/1e293b?text=Collaboration'"
        />

        <!-- Floating Badge -->
        <div
          class="absolute -bottom-6 -right-6 bg-white dark:bg-slate-800 p-4 rounded-lg shadow-xl border border-slate-100 dark:border-slate-700 z-20 hidden md:block"
          id="process-badge"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-10 h-10 rounded-full bg-green-100 dark:bg-green-900/50 flex items-center justify-center text-green-600 dark:text-green-400"
            >
              <i
                class="fas fa-sync-alt fa-spin"
                style="animation-duration: 3s;"></i>
            </div>
            <div>
              <div class="text-xs text-slate-500 dark:text-slate-400 font-bold uppercase">
                Status
              </div>
              <div class="text-sm font-bold text-slate-900 dark:text-white">Sprint Active</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Process Steps with Timeline -->
      <div class="order-1 lg:order-2" id="process-steps-container">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-6 tracking-tight">
          Seamless Integration Into Your Workflow
        </h2>
        <p class="text-slate-600 dark:text-slate-400 mb-12">
          I adapt to your tools, not the other way around. Whether you use Jira,
          Trello, Slack, or Teams, I plug directly into your ecosystem.
        </p>

        <div class="space-y-12 relative">
          <!-- Timeline Line Background -->
          <div
            class="absolute left-[19px] top-4 bottom-4 w-0.5 bg-slate-200 dark:bg-slate-700 hidden md:block"
          >
          </div>
          <!-- Timeline Line Fill (Animated) -->
          <div
            class="absolute left-[19px] top-4 bottom-12 w-0.5 bg-blue-600 hidden md:block process-line origin-top transform scale-y-0"
          >
          </div>

          <!-- Step 1 -->
          <div class="relative flex gap-6 process-step opacity-0 translate-y-8">
            <div
              class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 font-bold flex items-center justify-center shrink-0 z-10 border-4 border-white dark:border-slate-950 shadow-sm ring-1 ring-slate-100 dark:ring-slate-700"
            >
              1
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-lg mb-2">
                Briefing & Handoff
              </h4>
              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                Send Figma designs and specs. We do a quick sync to clarify
                requirements and set expectations.
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="relative flex gap-6 process-step opacity-0 translate-y-8">
            <div
              class="w-10 h-10 rounded-full bg-white dark:bg-slate-800 text-slate-400 font-bold flex items-center justify-center shrink-0 z-10 border-4 border-white dark:border-slate-950 shadow-sm ring-1 ring-slate-100 dark:ring-slate-700 group-hover:bg-blue-100 transition"
            >
              2
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-lg mb-2">
                Development Sprints
              </h4>
              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                Regular updates, git commits, and staging links. You have full
                visibility into the codebase at all times.
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="relative flex gap-6 process-step opacity-0 translate-y-8">
            <div
              class="w-10 h-10 rounded-full bg-white dark:bg-slate-800 text-slate-400 font-bold flex items-center justify-center shrink-0 z-10 border-4 border-white dark:border-slate-950 shadow-sm ring-1 ring-slate-100 dark:ring-slate-700"
            >
              3
            </div>
            <div>
              <h4 class="font-bold text-slate-900 dark:text-white text-lg mb-2">
                QA & Delivery
              </h4>
              <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
                Rigorous testing before final delivery. Post-launch support
                included to ensure a smooth handover.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // @ts-ignore
    const gsap = window.gsap;
    // @ts-ignore
    const ScrollTrigger = window.ScrollTrigger;

    if (!gsap || !ScrollTrigger) return;

    gsap.registerPlugin(ScrollTrigger);

    // 1. Process Timeline Line Animation
    gsap.to('.process-line', {
      scrollTrigger: {
        trigger: '#process-steps-container',
        start: 'top 70%',
        end: 'bottom 70%',
        scrub: 1,
      },
      scaleY: 1,
      ease: 'none',
    });

    // 2. Process Steps Stagger Animation
    const steps = document.querySelectorAll('.process-step');

    steps.forEach((step) => {
      gsap.to(step, {
        scrollTrigger: {
          trigger: step,
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        },
        opacity: 1,
        y: 0,
        duration: 0.6,
        ease: 'power2.out',
      });

      const circle = step.querySelector('div:first-child');
      gsap.to(circle, {
        scrollTrigger: {
          trigger: step,
          start: 'top 60%',
          toggleActions: 'play none none reverse',
        },
        backgroundColor: '#3b82f6',
        color: '#ffffff',
        duration: 0.3,
      });
    });

    // 3. Process Image Parallax
    gsap.to('#process-img', {
      scrollTrigger: {
        trigger: '#process-image-container',
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1,
      },
      y: 40,
      ease: 'none',
    });

    // 4. Badge Float Entry
    gsap.from('#process-badge', {
      scrollTrigger: {
        trigger: '#process-image-container',
        start: 'top 70%',
      },
      x: 50,
      opacity: 0,
      duration: 1,
      delay: 0.2,
      ease: 'back.out(1.7)',
    });
  });
</script>
