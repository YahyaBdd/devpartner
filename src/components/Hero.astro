---
const whatsappBase = 'https://wa.me/212702002742';
---

<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden hero-bg">
  <div
    class="absolute top-0 right-0 -mr-20 -mt-20 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 -ml-20 -mb-20 w-[500px] h-[500px] bg-cyan-500/10 rounded-full blur-3xl"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-900/50 border border-blue-700/50 mb-6"
        >
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          <span
            class="text-blue-100 text-xs font-semibold uppercase tracking-wider"
            data-i18n="hero.badge"
            >Available for New Projects</span
          >
        </div>
        <h1
          class="text-4xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight mb-6"
        >
          <span data-i18n="hero.titleLine1">Scale Your Agency</span> <br />
          <span class="gradient-text" data-i18n="hero.titleLine2">Without The Overhead.</span>
        </h1>
        <p
          class="text-lg text-slate-400 mb-8 max-w-2xl mx-auto lg:mx-0 leading-relaxed"
          data-i18n="hero.description"
        >
          I am your silent technical partner. Premium white-label full-stack
          development for European agencies. Based in Morocco (GMT+1) for
          seamless, real-time collaboration.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href={`${whatsappBase}?text=Hi%2C%20I%27d%20like%20to%20start%20scaling%20my%20agency%20with%20your%20help`}
            target="_blank"
            class="px-8 py-4 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg transition shadow-lg shadow-blue-600/30 flex items-center justify-center gap-2"
          >
            <span data-i18n="hero.ctaPrimary">Start Scaling Now</span> <i class="fas fa-arrow-right"></i>
          </a>
          <a
            href="#portfolio"
            class="px-8 py-4 bg-slate-800 hover:bg-slate-700 text-white font-semibold rounded-lg transition border border-slate-700 flex items-center justify-center gap-2"
            data-i18n="hero.ctaSecondary"
          >
            View Portfolio
          </a>
        </div>

        <!-- Trust Signals -->
        <div class="mt-10 pt-8 border-t border-slate-800">
          <p
            class="text-sm text-slate-500 mb-4 uppercase tracking-widest font-semibold"
            data-i18n="hero.techStack"
          >
            Tech Stack Expertise
          </p>
          <div
            class="flex gap-6 justify-center lg:justify-start text-slate-400 text-2xl"
          >
            <i class="fab fa-react hover:text-blue-400 transition" title="React"
            ></i>
            <i
              class="fab fa-node hover:text-green-500 transition"
              title="Node.js"></i>
            <i
              class="fab fa-laravel hover:text-red-500 transition"
              title="Laravel"></i>
            <i
              class="fab fa-js hover:text-yellow-400 transition"
              title="JavaScript"></i>
            <i
              class="fab fa-aws hover:text-orange-400 transition"
              title="AWS"></i>
          </div>
        </div>
      </div>

      <!-- Graphic/Visual -->
      <div class="hidden lg:block relative">
        <div class="relative w-full max-w-lg mx-auto animate-float">
          <!-- Code Window -->
          <div
            class="bg-slate-900 rounded-xl shadow-2xl border border-slate-700 overflow-hidden"
          >
            <div
              class="bg-slate-800 px-4 py-3 border-b border-slate-700 flex items-center gap-2"
            >
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-green-500"></div>
              <div class="ml-auto text-xs text-slate-400 font-mono">
                App.tsx
              </div>
            </div>
            <div class="p-6 font-mono text-sm">
              <div class="text-purple-400">
                const <span class="text-yellow-300">EuropeanAgency</span> =
                <span class="text-blue-400">async</span> () =&gt; {"{"}
              </div>
              <div class="pl-4 text-slate-300">
                <span class="text-purple-400">const</span> partner = <span
                  class="text-blue-400">await</span
                > findDev({"{"}<br />
                &nbsp;&nbsp;location: <span class="text-green-400"
                  >'Morocco'</span
                >,<br />
                &nbsp;&nbsp;timezone: <span class="text-green-400"
                  >'GMT+1'</span
                >,<br />
                &nbsp;&nbsp;quality: <span class="text-green-400"
                  >'Premium'</span
                ><br />
                {"}"});
              </div>
              <div class="pl-4 mt-2 text-slate-300">
                <span class="text-slate-500"
                  >// Result: Seamless Integration</span
                ><br />
                <span class="text-blue-400">return</span> partner.<span
                  class="text-yellow-300">scaleBusiness</span
                >();
              </div>
              <div class="text-purple-400">{"}"}</div>
            </div>
          </div>

          <!-- Floating Badge 1 -->
          <div
            class="absolute -top-6 -right-6 bg-white dark:bg-slate-800 p-4 rounded-lg shadow-xl border border-slate-100 dark:border-slate-700 flex items-center gap-3 animate-[pulse_4s_infinite]"
          >
            <div class="bg-green-100 dark:bg-green-900/50 p-2 rounded-full text-green-600 dark:text-green-400">
              <i class="fas fa-check"></i>
            </div>
            <div>
              <div class="text-xs text-slate-500 dark:text-slate-400 font-semibold" data-i18n="hero.deliveryLabel">Delivery</div>
              <div class="text-sm font-bold text-slate-800 dark:text-white" data-i18n="hero.deliveryValue">On Time</div>
            </div>
          </div>

          <!-- Floating Badge 2 -->
          <div
            class="absolute -bottom-6 -left-6 bg-white dark:bg-slate-800 p-4 rounded-lg shadow-xl border border-slate-100 dark:border-slate-700 flex items-center gap-3"
          >
            <div class="bg-blue-100 dark:bg-blue-900/50 p-2 rounded-full text-blue-600 dark:text-blue-400">
              <i class="fas fa-clock"></i>
            </div>
            <div>
              <div class="text-xs text-slate-500 dark:text-slate-400 font-semibold" data-i18n="hero.timezoneLabel">Timezone</div>
              <div class="text-sm font-bold text-slate-800 dark:text-white">GMT+1</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
