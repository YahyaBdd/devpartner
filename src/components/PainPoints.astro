---
const painPoints = [
  {
    icon: 'fa-ban',
    colorClass: 'bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400',
    titleKey: 'painpoints.item1.title',
    title: 'Turning Down Clients',
    descKey: 'painpoints.item1.description',
    description:
      "You're forced to say \"no\" to new projects because your in-house team is at max capacity.",
  },
  {
    icon: 'fa-chart-line',
    colorClass: 'bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400',
    titleKey: 'painpoints.item2.title',
    title: 'Margin Compression',
    descKey: 'painpoints.item2.description',
    description:
      'Hiring senior local developers in Europe eats into your project margins significantly.',
  },
  {
    icon: 'fa-bed',
    colorClass: 'bg-purple-100 dark:bg-purple-900/30 text-purple-600 dark:text-purple-400',
    titleKey: 'painpoints.item3.title',
    title: 'Communication Lag',
    descKey: 'painpoints.item3.description',
    description:
      'Tried outsourcing to Asia? Waking up to messages sent 8 hours ago kills project momentum.',
  },
];
---

<section class="py-20 bg-white dark:bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-4 tracking-tight" data-i18n="painpoints.title">
        Is Your Agency Facing These Bottlenecks?
      </h2>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl mx-auto" data-i18n="painpoints.subtitle">
        Great agencies often stall because fulfillment can't keep up with sales.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {
        painPoints.map((item) => (
          <div class="bg-slate-50 dark:bg-slate-800/50 p-8 rounded-2xl border border-slate-100 dark:border-slate-700 hover:shadow-lg transition group">
            <div
              class={`w-12 h-12 ${item.colorClass} rounded-xl flex items-center justify-center text-xl mb-6 group-hover:scale-110 transition`}
            >
              <i class={`fas ${item.icon}`} />
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3 tracking-tight" data-i18n={item.titleKey}>
              {item.title}
            </h3>
            <p class="text-slate-600 dark:text-slate-300" data-i18n={item.descKey}>{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
