---
const whatsappBase = 'https://wa.me/212702002742';
---

<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center mb-16 tracking-tight">
      Flexible Engagement Models
    </h2>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Transactional -->
      <div
        class="p-8 border border-slate-200 rounded-2xl hover:shadow-xl transition-shadow bg-white"
      >
        <div class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-2">
          Transactional
        </div>
        <h3 class="text-3xl font-bold text-slate-900 mb-6">Project Based</h3>
        <p class="text-slate-600 mb-8 h-12">
          Perfect for specific features, MVP builds, or one-off client
          deliverables.
        </p>
        <ul class="space-y-4 mb-8 text-sm">
          <li class="flex items-center gap-3 text-slate-700">
            <div
              class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center text-green-600 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            Fixed Scope & Price
          </li>
          <li class="flex items-center gap-3 text-slate-700">
            <div
              class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center text-green-600 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            30-Day Bug Warranty
          </li>
          <li class="flex items-center gap-3 text-slate-700">
            <div
              class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center text-green-600 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            Staged Payments
          </li>
        </ul>
        <a
          href={`${whatsappBase}?text=Hi%2C%20I%27d%20like%20to%20get%20a%20quote%20for%20a%20project`}
          target="_blank"
          class="block w-full py-3 bg-white border-2 border-slate-900 text-slate-900 font-bold text-center rounded hover:bg-slate-50 transition-colors"
        >
          Get a Quote
        </a>
      </div>

      <!-- Partnership -->
      <div
        class="p-8 border border-blue-200 bg-blue-50/50 rounded-2xl hover:shadow-xl transition-shadow relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 bg-brand-accent text-white text-xs font-bold px-3 py-1 rounded-bl-lg"
        >
          POPULAR
        </div>
        <div class="text-sm font-bold text-blue-600 uppercase tracking-widest mb-2">
          Partnership
        </div>
        <h3 class="text-3xl font-bold text-slate-900 mb-6">Monthly Retainer</h3>
        <p class="text-slate-600 mb-8 h-12">
          Reserve my capacity. Think of me as your fractional senior developer.
        </p>
        <ul class="space-y-4 mb-8 text-sm">
          <li class="flex items-center gap-3 text-slate-700">
            <div
              class="w-6 h-6 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            Dedicated hours/month
          </li>
          <li class="flex items-center gap-3 text-slate-700">
            <div
              class="w-6 h-6 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            Priority Slack Access
          </li>
          <li class="flex items-center gap-3 text-slate-700">
            <div
              class="w-6 h-6 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            Rollover Unused Hours
          </li>
        </ul>
        <a
          href={`${whatsappBase}?text=Hi%2C%20I%27d%20like%20to%20inquire%20about%20monthly%20retainer%20availability`}
          target="_blank"
          class="block w-full py-3 bg-brand-accent text-white font-bold text-center rounded hover:bg-blue-600 transition-colors"
        >
          Inquire Availability
        </a>
      </div>
    </div>
  </div>
</section>
