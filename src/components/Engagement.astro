---
const whatsappBase = 'https://wa.me/212702002742';
---

<section class="py-24 bg-white dark:bg-slate-950">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center mb-16 tracking-tight dark:text-white" data-i18n="engagement.title">
      Flexible Engagement Models
    </h2>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Transactional -->
      <div
        class="p-8 border border-slate-200 dark:border-slate-700 rounded-2xl hover:shadow-xl transition-shadow bg-white dark:bg-slate-900"
      >
        <div class="text-sm font-bold text-slate-400 uppercase tracking-widest mb-2" data-i18n="engagement.transactional">
          Transactional
        </div>
        <h3 class="text-3xl font-bold text-slate-900 dark:text-white mb-6" data-i18n="engagement.projectBased">Project Based</h3>
        <p class="text-slate-600 dark:text-slate-300 mb-8 h-12" data-i18n="engagement.projectDesc">
          Perfect for specific features, MVP builds, or one-off client
          deliverables.
        </p>
        <ul class="space-y-4 mb-8 text-sm">
          <li class="flex items-center gap-3 text-slate-700 dark:text-slate-300">
            <div
              class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/50 flex items-center justify-center text-green-600 dark:text-green-400 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            <span data-i18n="engagement.fixedScope">Fixed Scope & Price</span>
          </li>
          <li class="flex items-center gap-3 text-slate-700 dark:text-slate-300">
            <div
              class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/50 flex items-center justify-center text-green-600 dark:text-green-400 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            <span data-i18n="engagement.bugWarranty">30-Day Bug Warranty</span>
          </li>
          <li class="flex items-center gap-3 text-slate-700 dark:text-slate-300">
            <div
              class="w-6 h-6 rounded-full bg-green-100 dark:bg-green-900/50 flex items-center justify-center text-green-600 dark:text-green-400 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            <span data-i18n="engagement.stagedPayments">Staged Payments</span>
          </li>
        </ul>
        <a
          href={`${whatsappBase}?text=Hi%2C%20I%27d%20like%20to%20get%20a%20quote%20for%20a%20project`}
          target="_blank"
          class="block w-full py-3 bg-white dark:bg-slate-800 border-2 border-slate-900 dark:border-slate-500 text-slate-900 dark:text-white font-bold text-center rounded hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors"
          data-i18n="engagement.getQuote"
        >
          Get a Quote
        </a>
      </div>

      <!-- Partnership -->
      <div
        class="p-8 border border-blue-200 dark:border-blue-800 bg-blue-50/50 dark:bg-blue-900/20 rounded-2xl hover:shadow-xl transition-shadow relative overflow-hidden"
      >
        <div
          class="absolute top-0 right-0 bg-brand-accent text-white text-xs font-bold px-3 py-1 rounded-bl-lg"
          data-i18n="engagement.popular"
        >
          POPULAR
        </div>
        <div class="text-sm font-bold text-blue-600 dark:text-blue-400 uppercase tracking-widest mb-2" data-i18n="engagement.partnership">
          Partnership
        </div>
        <h3 class="text-3xl font-bold text-slate-900 dark:text-white mb-6" data-i18n="engagement.monthlyRetainer">Monthly Retainer</h3>
        <p class="text-slate-600 dark:text-slate-300 mb-8 h-12" data-i18n="engagement.retainerDesc">
          Reserve my capacity. Think of me as your fractional senior developer.
        </p>
        <ul class="space-y-4 mb-8 text-sm">
          <li class="flex items-center gap-3 text-slate-700 dark:text-slate-300">
            <div
              class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            <span data-i18n="engagement.dedicatedHours">Dedicated hours/month</span>
          </li>
          <li class="flex items-center gap-3 text-slate-700 dark:text-slate-300">
            <div
              class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            <span data-i18n="engagement.slackAccess">Priority Slack Access</span>
          </li>
          <li class="flex items-center gap-3 text-slate-700 dark:text-slate-300">
            <div
              class="w-6 h-6 rounded-full bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center text-blue-600 dark:text-blue-400 shrink-0"
            >
              <i class="fas fa-check text-xs"></i>
            </div>
            <span data-i18n="engagement.rolloverHours">Rollover Unused Hours</span>
          </li>
        </ul>
        <a
          href={`${whatsappBase}?text=Hi%2C%20I%27d%20like%20to%20inquire%20about%20monthly%20retainer%20availability`}
          target="_blank"
          class="block w-full py-3 bg-brand-accent text-white font-bold text-center rounded hover:bg-blue-600 transition-colors"
          data-i18n="engagement.inquire"
        >
          Inquire Availability
        </a>
      </div>
    </div>
  </div>
</section>
