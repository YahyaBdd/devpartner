---
import Copy from './Copy.astro';
import {projects,services,contact} from './data';
const {kind,number}=Astro.props;
---
{kind==='work' && <section id="portfolio" class="section work"><header class="section-heading"><span class="section-number">{number} /</span><Copy k="portfolio.title" tag="h2"/><Copy k="portfolio.subtitle"/></header><div class="projects">{projects.map((p,i)=><article class="project"><div class="project-image"><span class="project-index">0{i+1}</span><img src={p.image} alt={p.title} loading="lazy" width="1200" height="800"/></div><div class="project-copy"><div class="project-meta"><span>{p.type}</span><span>{p.location}</span></div><h3>{p.title}</h3><Copy k={p.key}/><div class="project-links">{p.links.length?p.links.map(([label,url])=><a href={url} target="_blank" rel="noopener noreferrer">{label} ↗</a>):<Copy k="portfolio.confidential" tag="span"/>}</div><small>{p.tech}</small></div></article>)}</div></section>}
{kind==='benefits' && <section id="benefits" class="section benefits"><header class="section-heading"><span class="section-number">{number} /</span><Copy k="nearshore.heading" tag="h2"/><Copy k="nearshore.subtitle"/></header><div class="connection" aria-label="Morocco and Europe: connected working hours"><span>Morocco <b>GMT+1</b></span><div class="connection-line"><i></i><i></i><i></i></div><span>Europe <b>In sync</b></span></div><div class="benefit-list">{['realtime','whitelabel','polyglot'].map((k,i)=><article><span class="item-mark">{['↔','◈','↗'][i]}</span><div><Copy k={`nearshore.${k}.title`} tag="h3"/><Copy k={`nearshore.${k}.description`}/></div></article>)}</div><div class="pain"><Copy k="painpoints.title" tag="h3"/><Copy k="painpoints.subtitle"/>{[1,2,3].map(i=><details><summary><Copy k={`painpoints.item${i}.title`} tag="span"/><span>+</span></summary><Copy k={`painpoints.item${i}.description`}/></details>)}</div></section>}
{kind==='services' && <section id="services" class="section services"><header class="section-heading"><span class="section-number">{number} /</span><Copy k="services.title" tag="h2"/><Copy k="services.subtitle"/></header><div class="service-list">{services.map((s,i)=><article><span class="service-number">0{i+1}</span><Copy k={`services.${s.key}`} tag="h3"/><ul>{s.items.map(item=><li>{item}</li>)}</ul><span class="service-arrow" aria-hidden="true">↗</span></article>)}</div></section>}
{kind==='process' && <section id="process" class="section process"><header class="section-heading"><span class="section-number">{number} /</span><Copy k="process.title" tag="h2"/><Copy k="process.subtitle"/></header><div class="steps">{[1,2,3].map(i=><article><span class="step-number">0{i}</span><Copy k={`process.step${i}.title`} tag="h3"/><Copy k={`process.step${i}.description`}/></article>)}</div><div class="tools">Figma <span>→</span> GitHub <span>→</span> Jira / Trello <span>→</span> Slack / Teams</div></section>}
{kind==='engagement' && <section id="engagement" class="section engagement"><header class="section-heading"><span class="section-number">{number} /</span><Copy k="engagement.title" tag="h2"/></header><div class="plans">{[false,true].map(retainer=><article><span class="plan-symbol" aria-hidden="true">{retainer?'∞':'↗'}</span><Copy k={retainer?'engagement.partnership':'engagement.transactional'} tag="small"/><Copy k={retainer?'engagement.monthlyRetainer':'engagement.projectBased'} tag="h3"/><Copy k={retainer?'engagement.retainerDesc':'engagement.projectDesc'}/><ul>{(retainer?['dedicatedHours','slackAccess','rolloverHours']:['fixedScope','bugWarranty','stagedPayments']).map(k=><li><span>✓</span><Copy k={`engagement.${k}`} tag="span"/></li>)}</ul><a class="button" href={contact(retainer?'Hi, I’d like to inquire about monthly retainer availability':'Hi, I’d like to get a quote for a project')} target="_blank" rel="noopener noreferrer"><Copy k={retainer?'engagement.inquire':'engagement.getQuote'} tag="span"/><span>↗</span></a></article>)}</div></section>}
{kind==='about' && <section id="about" class="section about"><figure><img src="/fes-image.webp" alt="Yahya overlooking the rooftops of Fes, Morocco" loading="lazy" width="1368" height="2360"/><figcaption>Yahya · Your development partner</figcaption></figure><div class="about-copy"><span class="section-number">{number} /</span><Copy k="about.title" tag="h2"/>{[1,2,3].map(i=><Copy k={`about.p${i}`}/>)}<a class="text-link" href="https://www.linkedin.com/in/yahya-bdd/" target="_blank" rel="noopener noreferrer"><Copy k="about.linkedin" tag="span"/> ↗</a></div></section>}
{kind==='testimonials' && <section id="testimonials" class="section testimonials"><Copy k="testimonials.title" tag="h2"/><div class="quotes">{['Johannes F.','Hassan B.'].map((name,i)=><figure><span class="quote-mark" aria-hidden="true">“</span><blockquote><Copy k={`testimonials.t${i+1}.quote`}/></blockquote><figcaption><b>{name}</b><Copy k={`testimonials.t${i+1}.role`} tag="span"/></figcaption></figure>)}</div></section>}
{kind==='faq' && <section id="faq" class="section faq"><header class="section-heading"><span class="section-number">{number} /</span><Copy k="faq.title" tag="h2"/></header><div>{[1,2,3,4].map(i=><details><summary><Copy k={`faq.q${i}.question`} tag="span"/><span class="plus">+</span></summary><Copy k={`faq.q${i}.answer`}/></details>)}</div></section>}
