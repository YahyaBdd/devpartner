---
import Copy from './Copy.astro';
import {contact,services} from './data';
import en from '../i18n/en.json';
---
<section class="hero" id="top"><div class="blue-heading"><div class="availability"><i></i><Copy k="hero.badge" tag="span"/></div><h1 data-i18n-html="hero.title" set:html={en["hero.title"]}/><Copy k="hero.description"/><a class="button" href={contact()} target="_blank" rel="noopener noreferrer"><Copy k="hero.partnerCta" tag="span"/><span>↗</span></a></div><div class="circuit"><div class="circuit-top"><span>PARTNERSHIP SYSTEM</span><span>● ONLINE</span></div><div class="node client-node"><small>INPUT</small><strong>Your agency</strong><span>Vision · Design · Clients</span></div><div class="wire"><span>Same working day ↔ GMT+1</span></div><div class="node partner-node"><span class="node-logo">dp↗</span><div><small>DEVELOPMENT PARTNER</small><strong>Yahya</strong></div><span class="node-status">●</span></div><div class="capability-tabs" role="tablist" aria-label="Explore capabilities">{services.map((s,i)=><button id={`cap-${i}`} role="tab" aria-controls="capability-panel" aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} data-capability={i}><Copy k={`services.${s.key}`} tag="span"/></button>)}</div><div class="capability-panel" id="capability-panel" role="tabpanel" aria-labelledby="cap-0" tabindex="0"><span>React.js / Next.js</span><span>Vue.js / Nuxt</span><span>Tailwind CSS / SCSS</span><span>TypeScript</span></div><div class="wire short"></div><div class="node output-node"><span>↗</span><strong>Your next delivery</strong><small>YOUR BRAND. ALWAYS.</small></div><div class="circuit-bottom">FIG. 01 — A seamless extension of your team</div></div></section>
